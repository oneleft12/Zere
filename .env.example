# ZERE: переменные окружения (пример).
#
# Нужны только для сценария «владелец/админ сервера»: его ключ живёт
# исключительно в окружении и используется только для его аккаунта.
# Обычный пользователь вводит свой ключ в панели («Подключение ИИ») —
# он сохраняется в config/ai.json (gitignored, права 0600).
#
# Скопируйте нужные строки в окружение (или в .env вашего лаунчера):
#   Linux/macOS:  export ZERE_CLOUD_API_KEY=sk-...
#   Windows:      setx ZERE_CLOUD_API_KEY "sk-..."
#
# Подробности: docs/AI_PROVIDERS.md

# Режим выбора провайдера: auto | cloud | local
ZERE_AI_MODE=auto

# Облачная модель (OpenAI-совместимый API)
ZERE_CLOUD_PROVIDER=openai
ZERE_CLOUD_BASE_URL=https://api.openai.com/v1
ZERE_CLOUD_MODEL=gpt-4o-mini
# Ключ владельца. НИКОГДА не коммитить: файл .env в .gitignore.
ZERE_CLOUD_API_KEY=

# Локальная модель (Ollama по умолчанию — лёгкая модель для слабых ПК)
ZERE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
ZERE_LOCAL_MODEL=qwen3.5:2b

# ── Роутер интентов на Jev (TypeSafe System One) ─────────────────────
# Необязательный слой перед обработчиками команд: Jev за ~100–500 мс
# определяет интент свободной фразы, действует код. Выключен по умолчанию.
# Подробности: docs/JEV_ROUTER.md
#
# Jev доступен на OpenRouter как `~typesafe/jev-latest` и работает по
# ключу OpenRouter (`sk-or-...`). Ключ шлюза OpenCode Go (`oc_sk_...`)
# для Jev НЕ подходит. Ключ можно положить и в config/router.json.
# Включение: ZERE_JEV_ROUTER=1
ZERE_JEV_ROUTER=0
JEV_API_KEY=
# Альтернативное имя переменной: ключ OpenRouter (тот же ключ, что для ИИ)
OPENROUTER_API_KEY=
