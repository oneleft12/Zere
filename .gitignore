appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.pem
*.key

# Если у тебя есть файл с API-ключами, токенами и т.п.
secrets/
.env
.env.local

# =========================
# WPF / WinForms / Desktop
# =========================

# Если есть временные файлы дизайнера
*.g.cs
*.g.i.cs

# Но обычно *.g.cs генерируется автоматически,
# поэтому лучше не коммитить лишнее, если это не требуется

# =========================
# Прочее
# =========================

Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store


# Файлы моделей (Whisper и т.д.)
*.bin
*.onnx
*.ort
*.pt
*.pb

# Piper TTS (внешние бинарники)
JARVIS.Voice/Piper/*.exe
JARVIS.Voice/Piper/*.dll
JARVIS.Voice/Piper/espeak-ng-data/
JARVIS.Voice/Piper/pkgconfig/

# Если есть папка с бинарными моделями ML (Whisper, Piper и т.д.)
JARVIS.Voice/Models/
JARVIS.AI/Models/voice/input/record.wav

# Внешний TTS (xVibePocketTTS + uv) — ставится отдельно, в репозиторий не входит
tools/xVibePocketTTS/
tools/uv.exe
tools/uv.zip
tools/voice_cache/

# Голосовой референс пользователя (биометрия — не коммитим)
voice/reference.wav
# Тестовые WAV для сравнения звучания (генерируются вручную, не коммитим)
voice/tts_compare/
tools/uvw.exe
tools/uvx.exe

# Токен локальной панели (создаётся при старте, не публикуем)
config/panel.token

# Артефакты установщика (генерируются)
/JarvisInstaller.exe
/JARVIS.bat
/installer/install-manifest.json
/installer/stage/
/installer/stage.zip
/installer/Output/

# Зависимости панели (dist — наоборот, коммитим: раздаётся без node)
panel/node_modules/

# Артефакты E2E (Playwright)
panel/test-results/
panel/playwright-report/
