Desktop.ini
.DS_Store


# Файлы моделей (Whisper и т.д.)
*.bin
*.onnx
*.ort
*.pt
*.pb

# ChatTTS (TTS-движок): вывод синтеза и пользовательские голоса — рантайм-данные
# Промежуточные WAV синтеза и DSP (создаются и удаляются на лету)
ZERE.Voice/ChatTts/output_*.wav
ZERE.Voice/ChatTts/processed_*.wav
# Профили голоса пользователя (эмбеддинги *.pt закрыты общим правилом выше)
ZERE.Voice/ChatTts/voices/

# Наследие Piper: движок заменён на ChatTTS, код и модели удалены из репозитория.
# У кого Piper был установлен раньше, бинарники остаются в рабочей копии —
# в git они не попадают (удалить их можно `uninstall.ps1 -RemoveAssets`).
ZERE.Voice/Piper/

# Silero TTS (русский движок): модель v5_5_ru.pt закрыта общим правилом *.pt
# выше, а вывод синтеза и промежуточные WAV — рантайм-данные.
ZERE.Voice/Silero/output_*.wav
ZERE.Voice/Silero/processed_*.wav

# Если есть папка с бинарными моделями ML (Whisper и т.д.)
ZERE.Voice/Models/
ZERE.AI/Models/
# Записи микрофона (wake word и команды) — рантайм-данные, там голос пользователя
voice/input/

# Внешний TTS (xVibePocketTTS + uv) — ставится отдельно, в репозиторий не входит
tools/xVibePocketTTS/
tools/uv.exe
tools/uv.zip
tools/voice_cache/

# Голосовой референс пользователя (биометрия — не коммитим)
voice/reference.wav
# База данных: история диалогов и память пользователя — это данные, не код
zere.db
jarvis.db
# Тестовые WAV для сравнения звучания (генерируются вручную, не коммитим)
voice/tts_compare/
tools/uvw.exe
tools/uvx.exe

# Токен локальной панели (создаётся при старте, не публикуем)
config/panel.token

# Настройки ИИ и API-ключ облачной модели: секрет, живёт только локально
# (config/ai.json, права 0600; см. docs/AI_PROVIDERS.md)
config/ai.json
config/ai.json.tmp

# Настройки роутера интентов Jev (может содержать ключ OpenRouter;
# см. docs/JEV_ROUTER.md)
config/router.json

# Артефакты установщика (генерируются)
/ZereInstaller.exe
/ZERE.bat
/installer/install-manifest.json
/installer/install-log.txt
/installer/stage/
/installer/stage.zip
/installer/Output/

# Зависимости панели (dist — наоборот, коммитим: раздаётся без node)
panel/node_modules/

# Артефакты E2E (Playwright)
panel/test-results/
panel/playwright-report/

# Готовые рисунки ZERE (открываются в Paint файлом)
drawings/

# Данные для обучения wake word (живые записи, синтетика, шумы):
# сами записи голоса и чужие корпуса в репозиторий не попадают.
# Модель — наоборот, коммитится: ZERE.Voice/WakeWord/models/
data/wakeword/
# Архив MUSAN (~11 ГБ, качается только по флагу --download musan) и
# недокачанные файлы: обрыв загрузки не должен попадать в индекс.
data/wakeword/musan.tar.gz
*.part
