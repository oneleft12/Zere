<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZERE.Speaker</AssemblyName>
    <RootNamespace>ZERE.Speaker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!--
    Один источник истины: DSP (AudioProcessor) и плеер (AudioPlayer,
    AudioOutputFactory) живут в ZERE.Voice и подключаются сюда ссылкой на
    исходники, а не ссылкой на проект — иначе в хелпер уехали бы тяжёлые
    зависимости распознавания (sherpa-onnx, Whisper.net) на десятки мегабайт.
  -->
  <ItemGroup>
    <Compile Include="..\ZERE.Voice\Audio\AudioProcessor.cs" Link="Audio\AudioProcessor.cs" />
    <Compile Include="..\ZERE.Voice\Audio\AudioPlayer.cs" Link="Audio\AudioPlayer.cs" />
    <Compile Include="..\ZERE.Voice\Audio\AudioOutputFactory.cs" Link="Audio\AudioOutputFactory.cs" />
  </ItemGroup>

</Project>
