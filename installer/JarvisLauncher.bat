@echo off
rem JARVIS launcher (generated by installer\install.ps1, do not edit)
setlocal
cd /d "%~dp0"

if exist ".venv\Scripts\python.exe" (
    echo [JARVIS] Starting Python edition...
    ".venv\Scripts\python.exe" main.py
    goto :end
)

if exist "publish\app\JARVIS.App.exe" (
    echo [JARVIS] Starting .NET edition...
    "publish\app\JARVIS.App.exe"
    goto :end
)

where python >nul 2>nul
if not errorlevel 1 (
    echo [JARVIS] .venv not found, trying system python...
    python main.py
    goto :end
)

echo [JARVIS] JARVIS is not installed yet.
echo [JARVIS] Run installer\Install-Jarvis.bat first.

:end
echo.
pause
