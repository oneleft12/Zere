@echo off
rem ZERE launcher (generated by installer\install.ps1, do not edit)
setlocal
cd /d "%~dp0"

rem Smart App Control (Windows 11) blocks locally built unsigned exe:
rem in that mode start signed pythonw.exe - same window, no console.
set "SAC=0"
reg query "HKLM\SYSTEM\CurrentControlSet\Control\CI\Policy" /v VerifiedAndReputablePolicyState 2>nul | find "0x1" >nul
if not errorlevel 1 set "SAC=1"

if "%SAC%"=="0" if exist "zere.exe" (
    echo [ZERE] Starting application...
    "zere.exe" %*
    goto :end
)

if exist ".venv\Scripts\pythonw.exe" (
    echo [ZERE] Starting application via pythonw...
    start "" ".venv\Scripts\pythonw.exe" main.py --desktop %*
    goto :end
)

if exist ".venv\Scripts\python.exe" (
    echo [ZERE] Starting Python edition in console...
    ".venv\Scripts\python.exe" main.py %*
    goto :end
)

if exist "publish\app\ZERE.App.exe" (
    echo [ZERE] Starting .NET edition...
    "publish\app\ZERE.App.exe" %*
    goto :end
)

where python >nul 2>nul
if not errorlevel 1 (
    echo [ZERE] .venv not found, trying system python...
    python main.py %*
    goto :end
)

echo [ZERE] ZERE is not installed yet.
echo [ZERE] Run installer\Install-Zere.bat first.

:end
echo.
pause
